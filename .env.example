# Copy to .env in the project root. The server reads it at startup.
# Select gemini, openai or custom and set the corresponding credentials.
# With no provider configured, geographic evidence remains available and live chat is disabled.
GEOAI_LLM_PROVIDER=

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# OpenAI or a custom OpenAI-compatible service
OPENAI_API_KEY=
LLM_MODEL=

# Supply the full Chat Completions URL and model name for a custom service.
# Example for local Ollama: http://127.0.0.1:11434/v1/chat/completions
LLM_API_URL=
LLM_API_KEY=

# Optional Nominatim-compatible search endpoint for names absent from the local GeoNames index.
MUGLA_GEOCODER_URL=
